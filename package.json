{
  "name": "alan-web-master-template",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0",
    "bun": ">=1.4.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm run --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter @app/web dev",
    "dev:api": "pnpm --filter @app/api dev",
    "build": "pnpm --filter @app/shared build && pnpm --filter @app/api build && pnpm --filter @app/web build",
    "start": "pnpm run --parallel --filter \"./apps/*\" start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
