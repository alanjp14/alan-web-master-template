# @app/api — Bun + Hono service. Every variable is optional; the defaults
# below are what `bun dev` uses with no .env file. Copy to `.env` for local
# overrides (`.env` is git-ignored).

# Port the API binds to.
# API_PORT=3001

# Comma-separated browser origins allowed to call the API (CORS). In
# development any origin is reflected; this list is enforced in production.
# API_ALLOWED_ORIGINS=http://localhost:3000,https://app.example.com

# NODE_ENV=production tightens CORS and hides internal error messages.
# NODE_ENV=development
