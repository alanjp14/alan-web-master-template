# @app/api — Bun + Hono service. Copy to `.env` for local overrides (`.env`
# is git-ignored). Everything below has a dev-safe default EXCEPT the two
# marked required — those throw at startup once NODE_ENV=production.

# Port the API binds to.
# API_PORT=3001

# Comma-separated browser origins allowed to call the API (CORS) and to
# receive the Better Auth session cookie. In development any origin is
# reflected; this list is enforced in production.
# API_ALLOWED_ORIGINS=http://localhost:3000,https://app.example.com

# This API's own public origin — Better Auth uses it to build cookie and
# callback URLs. Must match how the API is actually reached (e.g. your
# VPS's domain/reverse-proxy origin), not an internal address.
# API_PUBLIC_URL=https://api.example.com

# Postgres connection string. Dev default points at the docker-compose
# service in `docker-compose.yml` (postgres://app:app@localhost:55432/app).
# REQUIRED in production — no default.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Signs and encrypts session tokens (Better Auth). Generate a real one with:
#   openssl rand -base64 32
# REQUIRED in production — no default. Never reuse the dev value, and never
# commit the real value; anyone holding it can forge sessions.
# BETTER_AUTH_SECRET=

# NODE_ENV=production enforces the two REQUIRED variables above, tightens
# CORS to API_ALLOWED_ORIGINS, hides internal error messages, and sets the
# session cookie SameSite=None; Secure (needed once web and api are on
# different origins/domains, e.g. Vercel + a VPS).
# NODE_ENV=development
