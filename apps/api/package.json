{
  "name": "@app/api",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "module": "src/index.ts",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir dist --minify",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bunx drizzle-kit migrate",
    "db:push": "bunx drizzle-kit push",
    "db:studio": "bunx drizzle-kit studio"
  },
  "dependencies": {
    "@app/shared": "workspace:*",
    "better-auth": "^1.7.4",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.9.10",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/bun": "^1.4.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "globals": "^16",
    "typescript": "^5",
    "typescript-eslint": "^8"
  }
}
